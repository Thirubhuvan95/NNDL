import cv2
import numpy as np
import matplotlib.pyplot as plt
import tensorflow as tf


# 1. Build CNN model
model = tf.keras.Sequential([
    tf.keras.layers.Input(shape=(256,256,3)),
    tf.keras.layers.Conv2D(32, 3, padding='same', activation='relu'),
    tf.keras.layers.Conv2D(16, 3, padding='same', activation='relu'),
    tf.keras.layers.Conv2D(1, 3, padding='same', activation='sigmoid')
])

model.compile(optimizer='adam', loss='mse')


# 2. Load your own image
img_path = "/content/Screenshot 2026-02-04 160855.png"

img = cv2.imread(img_path)

if img is None:
    print("Image not found!")
    exit()


# 3. Preprocess image
img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
img = cv2.resize(img, (256,256))
img = img / 255.0

img_input = np.expand_dims(img, axis=0)


# 4. Predict grayscale (WITHOUT training → random result)
gray_output = model.predict(img_input)
gray_output = gray_output[0,:,:,0]


# 5. Show result
plt.figure(figsize=(8,4))

plt.subplot(1,2,1)
plt.title("Original RGB")
plt.imshow(img)
plt.axis("off")

plt.subplot(1,2,2)
plt.title("CNN Grayscale (Untrained)")
plt.imshow(gray_output, cmap="gray")
plt.axis("off")

plt.show()
